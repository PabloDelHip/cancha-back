# Puerto HTTP del API (prefijo /api)
PORT=3000
# MongoDB del docker-compose (replica set rs0, necesario para transacciones).
# directConnection evita que el driver intente descubrir otros miembros.
MONGODB_URI=mongodb://localhost:27017/football_app?directConnection=true
# Origen(es) del frontend permitidos por CORS con credenciales (separados por coma). Nunca "*".
FRONTEND_URL=http://localhost:5173
# development | production | test
NODE_ENV=development

# JWT. Genera secretos propios y DISTINTOS, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción el API se niega a arrancar con secretos cortos (<32) o que contengan "change-me".
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=365d

# Rate limit en memoria por IP: login/registro (AUTH_THROTTLE_LIMIT) y refresh (AUTH_REFRESH_THROTTLE_LIMIT;
# cada carga de página restaura la sesión con un refresh), en ventanas de AUTH_THROTTLE_TTL segundos.
AUTH_THROTTLE_LIMIT=10
AUTH_REFRESH_THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL=60

# Proxies de confianza delante del API (Express "trust proxy"). 0 = conexión directa (local).
# En Cloud Run: 1, para que el rate limit por IP use la IP real del cliente y no la del proxy.
TRUST_PROXY_HOPS=0

# Cloudinary: imágenes de jugadores y equipos (MongoDB solo guarda la URL y el public_id).
# Panel de Cloudinary → Settings → API Keys. Las tres o ninguna; sin ellas el API arranca igual y
# PUT /players/:id/photo y PUT /teams/:id/logo responden 503. Nunca subas valores reales al repo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
